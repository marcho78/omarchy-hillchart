#!/usr/bin/python3 -IS
# Hill Chart's file access, all of it in one place.
#
# Every file Hill Chart reads or writes goes through here, so each is reached
# the same careful way: from "/" one directory at a time without following
# symbolic links, through directories that only their owner (you, or root)
# can write to, to a regular file with a single link, owned by you, writable
# by no one else, no bigger than a fixed size. Nothing is followed, nothing is
# read past its cap, and nothing is read whole into memory first.
#
# The projects file is replaced atomically: written to a new file created
# exclusively beside it (0600, readable by you only), synced, then renamed
# over it. Missing folders on the way are created 0700, inside your home
# folder only. Project names arrive on stdin, never on the command line,
# where other accounts could read them.
#
# What's read is printed as one JSON string, plain ASCII (everything else
# escaped), so the shell can take it in as it arrives without garbling a
# character split between two reads.
#
# Usage (Hill Chart runs it as /usr/bin/python3 -I -S <this file> ...):
#   hillchart-files read <file>     print the projects file at <file>
#   hillchart-files write <file>    replace the projects file at <file> with stdin
#   hillchart-files theme           print the current Omarchy theme's colors.toml
#
# <file> is an absolute path inside your home folder.
#
# Exit status: 0 done, 2 usage, 3 the file isn't there, 4 refused (why, on
# stderr).

import errno
import json
import os
import pwd
import re
import secrets
import stat
import sys
import time

KIB = 1024
MIB = 1024 * KIB

# Far above the most Hill Chart keeps (60 projects, each with its name and a
# short history of where it stood).
PROJECTS_CAP = 1 * MIB
THEME = ".local/state/omarchy/current/theme/colors.toml"
THEME_CAP = 64 * KIB

DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOCTTY


class Refused(Exception):
    pass


class Missing(Exception):
    pass


def uid():
    return os.getuid()


def home():
    # From the password database, not $HOME.
    return pwd.getpwuid(uid()).pw_dir.rstrip("/") or "/"


def clean_absolute(path):
    """The path, if it's absolute and plain: no "." or ".." or empty parts."""
    if not isinstance(path, str) or not path.startswith("/") or "\0" in path or len(path) > 4096:
        raise Refused("not an absolute path")
    parts = path.split("/")[1:]
    if path != "/" and any(p in ("", ".", "..") for p in parts):
        raise Refused("not a plain path")
    return path


def inside_home(path):
    """The path, if it names a file inside your home folder."""
    path = clean_absolute(path)
    if not path.startswith(home() + "/"):
        raise Refused("%s: not in your home folder" % path)
    return path


def check_dir(fd, path, owners):
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode):
        raise Refused("%s: not a directory" % path)
    if st.st_uid not in owners:
        raise Refused("%s: owned by someone else" % path)
    if st.st_mode & 0o022:
        raise Refused("%s: others can write to it" % path)


def open_dir(path, create_below=None):
    """Open the directory at `path`, one component at a time from "/" without
    following symbolic links; every directory on the way must belong to you
    or root and be writable by no one else. Missing directories below
    `create_below` are created, 0700 and yours."""
    path = clean_absolute(path)
    owners = {0, uid()}
    fd = os.open("/", DIR_FLAGS)
    try:
        check_dir(fd, "/", owners)
        current = ""
        for name in ([] if path == "/" else path.split("/")[1:]):
            current += "/" + name
            try:
                child = os.open(name, DIR_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                if create_below is None or not current.startswith(create_below + "/"):
                    raise Missing(current)
                os.mkdir(name, 0o700, dir_fd=fd)
                child = os.open(name, DIR_FLAGS, dir_fd=fd)
            except OSError as e:
                if e.errno in (errno.ELOOP, errno.ENOTDIR):
                    raise Refused("%s: not a real directory" % current)
                raise
            os.close(fd)
            fd = child
            check_dir(fd, current, owners)
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_file(dir_fd, name, path, cap):
    """The file's bytes: a regular file with one link, yours, writable by no
    one else, at most `cap` bytes."""
    try:
        fd = os.open(name, FILE_FLAGS, dir_fd=dir_fd)
    except FileNotFoundError:
        raise Missing(path)
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise Refused("%s: a symbolic link" % path)
        raise
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Refused("%s: not a regular file" % path)
        if st.st_uid != uid():
            raise Refused("%s: owned by someone else" % path)
        if st.st_nlink != 1:
            raise Refused("%s: has more than one link" % path)
        if st.st_mode & 0o022:
            raise Refused("%s: others can write to it" % path)
        if st.st_size > cap:
            raise Refused("%s: bigger than %d bytes" % (path, cap))
        chunks = []
        total = 0
        while True:
            chunk = os.read(fd, min(64 * KIB, cap + 1 - total))
            if not chunk:
                break
            total += len(chunk)
            if total > cap:
                raise Refused("%s: bigger than %d bytes" % (path, cap))
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        os.close(fd)


def read_in_folder(path, cap):
    folder, _, leaf = path.rpartition("/")
    fd = open_dir(folder)
    try:
        return read_file(fd, leaf, path, cap)
    finally:
        os.close(fd)


def read_projects(path):
    return read_in_folder(inside_home(path), PROJECTS_CAP)


def read_theme():
    return read_in_folder(home() + "/" + THEME, THEME_CAP)


def remove_stale_temps(fd, leaf):
    """Temp files of writes that were stopped part way (at their deadline),
    once they're a minute old: only names a write of ours makes, and only
    regular files of yours."""
    pattern = re.compile(r"\." + re.escape(leaf) + r"\.[0-9a-f]{16}\.tmp")
    now = time.time()
    with os.scandir(fd) as entries:
        for entry in entries:
            if not pattern.fullmatch(entry.name):
                continue
            try:
                st = entry.stat(follow_symlinks=False)
            except FileNotFoundError:
                continue
            if stat.S_ISREG(st.st_mode) and st.st_uid == uid() and now - st.st_mtime > 60:
                try:
                    os.unlink(entry.name, dir_fd=fd)
                except FileNotFoundError:
                    pass


def write_projects(path, data):
    if len(data) > PROJECTS_CAP:
        raise Refused("projects: bigger than %d bytes" % PROJECTS_CAP)
    try:
        value = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError, RecursionError):
        raise Refused("projects: not JSON")
    if not isinstance(value, dict):
        raise Refused("projects: not a JSON object")
    path = inside_home(path)
    folder, _, leaf = path.rpartition("/")
    fd = open_dir(folder, create_below=home())
    try:
        if os.fstat(fd).st_uid != uid():
            raise Refused("%s: owned by someone else" % folder)
        # Only a file of yours is replaced, never a link or anything else.
        try:
            st = os.stat(leaf, dir_fd=fd, follow_symlinks=False)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != uid():
                raise Refused("%s: not a file of yours" % path)
        except FileNotFoundError:
            pass
        remove_stale_temps(fd, leaf)
        temp = ".%s.%s.tmp" % (leaf, secrets.token_hex(8))
        out = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=fd)
        try:
            view = memoryview(data)
            while view:
                view = view[os.write(out, view):]
            os.fsync(out)
        except BaseException:
            os.close(out)
            os.unlink(temp, dir_fd=fd)
            raise
        os.close(out)
        try:
            os.rename(temp, leaf, src_dir_fd=fd, dst_dir_fd=fd)
        except BaseException:
            os.unlink(temp, dir_fd=fd)
            raise
        os.fsync(fd)
    finally:
        os.close(fd)


def as_ascii(data, cap):
    """`data` as a JSON string in plain ASCII. Text needs at most three
    characters out per byte in (a two-byte letter becomes \\u00e9); text that
    needs more (control characters, broken UTF-8) is refused rather than
    handed over six times its size."""
    out = json.dumps(data.decode("utf-8", "replace"))
    if len(out) > 3 * cap + 2:
        raise Refused("too much text that needs escaping")
    return out.encode("ascii") + b"\n"


def read_stdin(cap):
    data = sys.stdin.buffer.read(cap + 1)
    if len(data) > cap:
        raise Refused("input: bigger than %d bytes" % cap)
    return data


def main(argv):
    usage = "usage: hillchart-files read <file> | write <file> | theme\n"
    command = argv[1] if len(argv) > 1 else ""
    if not ((command in ("read", "write") and len(argv) == 3) or (command == "theme" and len(argv) == 2)):
        sys.stderr.write(usage)
        return 2
    try:
        if command == "read":
            sys.stdout.buffer.write(as_ascii(read_projects(argv[2]), PROJECTS_CAP))
        elif command == "write":
            write_projects(argv[2], read_stdin(PROJECTS_CAP))
        else:
            sys.stdout.buffer.write(as_ascii(read_theme(), THEME_CAP))
        sys.stdout.flush()
        return 0
    except Missing:
        return 3
    except Refused as e:
        sys.stderr.write("hillchart-files: %s\n" % e)
        return 4
    except OSError as e:
        sys.stderr.write("hillchart-files: %s\n" % (e.strerror or e))
        return 4


if __name__ == "__main__":
    sys.exit(main(sys.argv))
